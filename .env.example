# Configuration du script RMM Agent Manager v3.0

# URL prédéfinie pour télécharger l'agent
# Remplacez cette valeur par l'URL de votre agent NinjaRMM ou autre
PREDEFINED_AGENT_URL=http://example.com/agent.rpm

# Nom du service systemd à gérer
SERVICE_NAME=ninjarmm-agent.service

# Emplacement du fichier de logs
LOG_FILE=/var/log/ninjarmm_agent_manager.log

# Répertoire de téléchargement des packages
DOWNLOAD_DIR=/tmp

# Nom du package à installer/désinstaller
AGENT_PACKAGE_NAME=ninjarmm-agent

# Type de package à gérer
# Valeurs possibles: auto (détection automatique), rpm (Red Hat/CentOS/Fedora), deb (Debian/Ubuntu)
AGENT_PACKAGE_TYPE=auto

# Niveau de logs
# Valeurs possibles: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO

# Contrôles de sécurité (par défaut désactivés pour éviter tout changement automatique en production)
# Mettre à true pour autoriser l'installation automatique via le script
ALLOW_INSTALL=false

# Appliquer un drop-in systemd sûr pour éviter les crash-loops (Restart=on-failure)
# Mettre à true pour activer la création automatique du drop-in
SYSTEMD_SAFE_OVERRIDE=false
